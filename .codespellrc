[codespell]
# Read by both the pre-commit hook and `make codespell`, so the two cannot drift.
# The skip entries include path globs such as */testdata/*, because pre-commit
# passes file paths, which a bare directory name does not match. Hidden files
# are checked, as pre-commit passes .github/ files too, so .git, .claude and
# .venv are skipped explicitly, as is this file, which lists misspellings by
# design. The other skips are data rather than prose, or local untracked trees:
# external/ and references/ hold source and standards, notes/ is local notes,
# and cmd/hi265gray/data is a scratch area of hex parameter sets and captures.
check-hidden = true
skip = ./.git,./.claude,./.venv,./venv,.codespellrc,./vendor,./external,./references,./notes,./out,testdata,testdata/*,*/testdata/*,./cmd/hi265gray/data,./coverage.*,go.sum,*.y4m,*.yuv,*.265,*.hevc,*.mp4
# Words to leave alone, all of them domain vocabulary or identifiers:
#   ue           ue(v), the unsigned exponential-Golomb syntax element
#   trun, truns  the MP4 track run box, and mp4ff's Truns field holding them
#   nd           the %Nd frame-number format spec documented in pkg/timecode
#   unparseable  a variant spelling, used in a comment about a missing element
#   pich, localy the picH and localY identifiers
ignore-words-list = pich,localy,ue,trun,truns,nd,unparseable
